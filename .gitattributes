# 默认按文本处理，由 Git 自行判断是否转换换行符
* text=auto

# 源码
*.cs        text diff=csharp
*.csproj    text
*.sln       text eol=crlf

# Windows 脚本与工程文件统一使用 CRLF
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf
*.iss       text eol=crlf
*.manifest  text eol=crlf

# 文档
*.md        text
*.txt       text

# 二进制
*.png       binary
*.ico       binary
*.exe       binary
*.zip       binary
